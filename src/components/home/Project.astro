---
import type { CollectionEntry, RenderResult } from "astro:content";
import { getImage, Image } from "astro:assets";
import DateTime from "../DateTime.astro";
import Link from "../Link.astro";

type Props = CollectionEntry<"projects">["data"] & {
  id: string;
  Content: RenderResult["Content"];
};

const {
  id, class: className, title, client, challenge, role, outcome,
  image, imageAlt, imageCaption,
  buttonLabel, buttonTarget, url,
  responsibilities, startDate, endDate, Content,
} = Astro.props;
const revealImage = ["project-lab1886", "project-bosch", "project-copra"].includes(className ?? "");
const imageOptions = {
  src: image,
  alt: imageAlt,
  widths: [400, 800, 1200],
  sizes: "(min-width: 1024px) 50vw, 100vw",
};
const deferredImage = revealImage ? await getImage(imageOptions) : undefined;
---

<article class:list={["Project", className]} aria-labelledby={`${id}-title`}>
  <div class="Project-summary">
    <div class="Project-meta">
      <span>{client}</span>
      <DateTime format="YYYY" from={startDate} to={endDate} />
    </div>
    <h3 id={`${id}-title`}>{title}</h3>
    <dl class="Project-facts">
      <div>
        <dt>Challenge</dt>
        <dd>{challenge}</dd>
      </div>
      <div>
        <dt>My role</dt>
        <dd>{role}</dd>
      </div>
      <div class="Project-outcome">
        <dt>Outcome</dt>
        <dd>{outcome}</dd>
      </div>
    </dl>
  </div>
  <figure class="Project-visual">
    <div class="Project-image">
      {deferredImage ? (
        <>
          <img
            {...deferredImage.attributes}
            data-project-image
            data-src={deferredImage.src}
            data-srcset={deferredImage.srcSet.attribute}
            hidden
          />
          <noscript>
            <Image {...imageOptions} />
          </noscript>
        </>
      ) : <Image {...imageOptions} />}
    </div>
    {imageCaption && (
      <figcaption class="Project-image-caption">
        <strong>{imageCaption.title}</strong> — <strong>{imageCaption.lead}</strong> {imageCaption.description}
      </figcaption>
    )}
  </figure>
  <div class="Project-story">
    <details class="Project-details" open>
      <summary>
        <span class="Project-details-label"><span class="Project-details-text">Project details<span class="sr-only">: {client}</span></span></span>
        <span class="Project-toggle" aria-hidden="true"></span>
      </summary>
      <div class="Project-process">
        <div class="Project-narrative"><Content /></div>
        <aside aria-label={`${client} responsibilities`}>
          <h5>Responsibilities</h5>
          <ul>{responsibilities.map(item => <li>{item}</li>)}</ul>
        </aside>
        <div class="Project-link">
          <Link href={url} target={buttonTarget} icon={true}>{buttonLabel}</Link>
        </div>
      </div>
    </details>
  </div>
</article>

<script>
  import { initProjectImages } from "../../assets/scripts/projectImages";

  initProjectImages();

  const desktop = window.matchMedia("(min-width: 1024px)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const disclosureObserver = "IntersectionObserver" in window
    ? new IntersectionObserver(entries => {
      for (const entry of entries) {
        const summary = entry.target.querySelector("summary");
        if (summary) summary.setAttribute("data-visible", String(entry.isIntersecting));
      }
    })
    : undefined;

  document.querySelectorAll<HTMLDetailsElement>(".Project-details").forEach(details => {
    const summary = details.querySelector<HTMLElement>("summary")!;
    const content = details.querySelector<HTMLElement>(".Project-process")!;
    let mobileOpen = false;
    let animation: Animation | undefined;
    let contentAnimation: Animation | undefined;

    disclosureObserver?.observe(details);

    const sync = () => {
      animation?.cancel();
      contentAnimation?.cancel();
      animation = undefined;
      contentAnimation = undefined;
      delete details.dataset.animating;
      details.open = mobileOpen;
      details.dataset.expanded = String(details.open);
    };

    summary.addEventListener("click", event => {
      if (desktop.matches) return;
      event.preventDefault();

      mobileOpen = !mobileOpen;
      if (reducedMotion.matches) {
        sync();
        return;
      }

      const startHeight = details.getBoundingClientRect().height;
      const startOpacity = details.open ? getComputedStyle(content).opacity : "0";
      animation?.cancel();
      contentAnimation?.cancel();
      details.open = true;
      details.dataset.expanded = String(mobileOpen);
      details.dataset.animating = "true";
      const endHeight = mobileOpen
        ? details.getBoundingClientRect().height
        : summary.getBoundingClientRect().height;

      animation = details.animate(
        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
        { duration: 420, easing: "cubic-bezier(0.2, 0, 0, 1)" },
      );
      contentAnimation = content.animate(
        [{ opacity: startOpacity }, { opacity: mobileOpen ? 1 : 0 }],
        { duration: 420, easing: "ease-in-out", fill: "both" },
      );
      animation.onfinish = sync;
    });

    details.addEventListener("toggle", () => {
      if (animation) return;
      mobileOpen = details.open;
      details.dataset.expanded = String(details.open);
    });
    desktop.addEventListener("change", sync);
    reducedMotion.addEventListener("change", sync);
    sync();
  });
</script>

<style>
  .Project {
    display: grid;
    gap: 24px;
    padding-block: 32px;
    border-top: 1px solid var(--ui--medium-contrast);
    color: var(--on-background__high-emphasis);
  }
  .Project:last-of-type { border-bottom: 1px solid var(--ui--medium-contrast); }
  .Project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    margin: 0 0 12px;
    font: var(--typestyle__body--small);
    color: var(--on-background__medium-emphasis);
  }
  .Project-meta span {
    font-weight: var(--font-weight--bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h3 {
    margin: 0 0 24px;
    max-width: 18ch;
    font: var(--typestyle__h3);
    text-wrap: balance;
    color: var(--on-background__highest-emphasis);
  }
  .Project-facts {
    display: grid;
    gap: 16px;
    margin: 0;
  }
  dt {
    margin-bottom: 4px;
    font: var(--typestyle__h5);
  }
  dd {
    margin: 0;
    max-width: 48ch;
    font: var(--typestyle__body--small);
    color: var(--on-background__medium-emphasis);
  }
  .Project-outcome {
    padding-left: 16px;
    border-left: 3px solid var(--accent);
  }
  .Project-outcome dd {
    font: var(--typestyle__body--bold);
    color: var(--on-background__highest-emphasis);
  }
  .Project-image {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--project-color-tint, var(--project-default-tint));
  }
  .Project-visual { margin: 0; }
  .Project-image noscript { display: contents; }
  .Project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .Project-image img[hidden] { display: none; }
  .Project-image img[data-state="pending"] {
    opacity: 0;
    transform: translateY(64px);
  }
  .Project-image img[data-state="ready"] {
    animation:
      projectImageFade 1200ms ease-in-out,
      projectImageSlide 1500ms cubic-bezier(0.22, 1, 0.36, 1);
    opacity: 1;
    transform: none;
  }
  @keyframes projectImageFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes projectImageSlide {
    from { transform: translateY(64px); }
    to { transform: none; }
  }
  .Project-image-caption {
    margin-top: 12px;
    font: var(--typestyle__body--small);
    color: var(--on-background__medium-emphasis);
  }
  .Project-image-caption strong { color: var(--on-background__high-emphasis); }
  .project-lab1886 { --project-color-tint: var(--lab1886-project-color); }
  .project-lab1886 .Project-image {
    background: linear-gradient(
      to bottom,
      transparent clamp(16px, 2.5vw, 32px),
      var(--project-color-tint) 0
    );
  }
  .project-bosch { --project-color-tint: var(--bosch-project-color); }
  .project-copra { --project-color-tint: var(--copra-project-color); }
  .project-figma { --project-color-tint: var(--design-tokens-project-color); }
  .Project-details[data-animating] { overflow: clip; }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    cursor: pointer;
    list-style: none;
    font: var(--typestyle__h4);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
  summary[data-visible="false"]:not(:focus-within) .Project-details-text,
  summary[data-visible="false"]:not(:focus-within) .Project-toggle {
    opacity: 0;
  }
  summary[data-visible="false"]:not(:focus-within) .Project-toggle {
    translate: 0 24px;
  }
  .Project-details-label {
    position: relative;
    overflow: hidden;
  }
  .Project-details-label::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    pointer-events: none;
    --origin-start: left;
    --origin-end: right;
  }
  summary[data-visible="true"] .Project-details-label::after {
    animation: blockReveal 900ms var(--easeInOutQuint) both;
  }
  summary[data-visible="true"] .Project-details-text {
    animation: projectDetailsTextReveal 900ms step-end both;
  }
  @keyframes projectDetailsTextReveal {
    0% { opacity: 0; }
    50%, 100% { opacity: 1; }
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover,
  summary:focus-visible {
    background-color: var(--neutrals-50);
    color: var(--on-background__highest-emphasis);
  }
  .Project-details-label,
  .Project-toggle {
    transition: transform 200ms ease;
  }
  summary:hover .Project-details-label,
  summary:focus-visible .Project-details-label {
    transform: translateX(16px);
  }
  summary:hover .Project-toggle,
  summary:focus-visible .Project-toggle {
    transform: translateX(-16px);
  }
  @media (prefers-color-scheme: dark) {
    summary:hover,
    summary:focus-visible { background-color: var(--neutrals-950); }
  }
  summary:focus-visible {
    outline: 2px solid var(--on-background__highest-emphasis);
    outline-offset: 4px;
  }
  .Project-toggle {
    position: relative;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    transition:
      transform 200ms ease,
      opacity 420ms ease,
      translate 420ms cubic-bezier(0.2, 0, 0, 1);
  }
  .Project-toggle::before,
  .Project-toggle::after {
    content: "";
    position: absolute;
    background: currentColor;
  }
  .Project-toggle::before { width: 16px; height: 2px; top: 7px; }
  .Project-toggle::after {
    width: 2px;
    height: 16px;
    left: 7px;
    transition: transform 420ms cubic-bezier(0.2, 0, 0, 1);
  }
  details[open]:not([data-expanded="false"]) .Project-toggle::after {
    transform: rotate(90deg);
  }
  .Project-process {
    display: grid;
    gap: 24px;
    padding-block: 16px 24px;
    font: var(--typestyle__body--small);
    color: var(--on-background__medium-emphasis);
  }
  .Project-process :global(h5) {
    margin: 0 0 8px;
    font: var(--typestyle__h5);
    color: var(--on-background__high-emphasis);
  }
  .Project-process :global(p) {
    margin: 0 0 20px;
    max-width: 65ch;
  }
  .Project-process :global(p:last-child) { margin-bottom: 0; }
  .Project-narrative :global(a) { color: inherit; text-decoration: underline; }
  .Project-process ul { margin: 0; padding-left: 20px; }
  .Project-process li + li { margin-top: 6px; }
  .Project-link { grid-column: 1 / -1; padding-top: 8px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    summary,
    .Project-details-label,
    .Project-toggle { transition: none; }
    summary[data-visible="false"]:not(:focus-within) .Project-details-text,
    summary[data-visible="false"]:not(:focus-within) .Project-toggle {
      opacity: 1;
      translate: none;
    }
    .Project-details-label::after { display: none; }
    summary[data-visible="true"] .Project-details-text { animation: none; }
    .Project-toggle::after { transition: none; }
    .Project-image img[data-state] { animation: none; transform: none; }
  }
  @media (--min-tablet) {
    .Project { gap: 32px; padding-block: 48px; }
    .Project-facts { grid-template-columns: 1fr 1fr; gap: 24px; }
    .Project-outcome { grid-column: 1 / -1; }
    .Project-image { aspect-ratio: 16 / 9; }
    .Project-process { grid-template-columns: 2fr 1fr; gap: 48px; }
  }
  @media (--min-desktop) {
    .Project {
      grid-template-columns: 5fr 6fr;
      column-gap: clamp(40px, 5vw, 80px);
      align-items: center;
      padding-block: 56px 20px;
    }
    .Project:nth-child(even) .Project-summary {
      grid-column: 2;
      grid-row: 1;
    }
    .Project:nth-child(even) .Project-visual {
      grid-column: 1;
      grid-row: 1;
    }
    h3 { font: var(--typestyle__h2); margin-bottom: 28px; }
    .Project-facts { grid-template-columns: 1fr; gap: 20px; }
    .Project-image { aspect-ratio: 4 / 3; }
    .Project-story { grid-column: 1 / -1; }
    .Project-link { padding-top: 4px; }
  }
</style>
