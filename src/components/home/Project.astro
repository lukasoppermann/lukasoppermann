---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import DateTime from "../DateTime.astro";
import Link from "../Link.astro";

type Props = CollectionEntry<"projects">["data"] & {
  id: string;
  Content: Awaited<ReturnType<CollectionEntry<"projects">["render"]>>["Content"];
};

const {
  id, class: className, title, client, challenge, role, outcome,
  image, imageAlt, buttonLabel, buttonTarget, url,
  responsibilities, startDate, endDate, Content,
} = Astro.props;
---

<article class:list={["Project", className]} aria-labelledby={`${id}-title`}>
  <div class="Project-summary">
    <div class="Project-meta">
      <span>{client}</span>
      <DateTime format="YYYY" from={startDate} to={endDate} />
    </div>
    <h3 id={`${id}-title`}>{title}</h3>
    <dl class="Project-facts">
      <div>
        <dt>Challenge</dt>
        <dd>{challenge}</dd>
      </div>
      <div>
        <dt>My role</dt>
        <dd>{role}</dd>
      </div>
      <div class="Project-outcome">
        <dt>Outcome</dt>
        <dd>{outcome}</dd>
      </div>
    </dl>
  </div>
  <div class="Project-image">
    <Image src={image} alt={imageAlt} widths={[400, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" />
  </div>
  <div class="Project-story">
    <h4 class="Project-details-heading">Project details</h4>
    <details class="Project-details" open>
      <summary>
        Project details<span class="sr-only">: {client}</span>
        <span class="Project-toggle" aria-hidden="true"></span>
      </summary>
      <div class="Project-process">
        <div class="Project-narrative"><Content /></div>
        <aside aria-label={`${client} responsibilities`}>
          <h5>Responsibilities</h5>
          <ul>{responsibilities.map(item => <li>{item}</li>)}</ul>
        </aside>
      </div>
    </details>
    <div class="Project-link">
      <Link href={url} target={buttonTarget} icon={true}>{buttonLabel}</Link>
    </div>
  </div>
</article>

<script>
  const desktop = window.matchMedia("(min-width: 1024px)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLDetailsElement>(".Project-details").forEach(details => {
    const summary = details.querySelector<HTMLElement>("summary")!;
    const content = details.querySelector<HTMLElement>(".Project-process")!;
    let mobileOpen = false;
    let animation: Animation | undefined;
    let contentAnimation: Animation | undefined;

    const sync = () => {
      animation?.cancel();
      contentAnimation?.cancel();
      animation = undefined;
      contentAnimation = undefined;
      delete details.dataset.animating;
      details.open = desktop.matches || mobileOpen;
      details.dataset.expanded = String(details.open);
    };

    summary.addEventListener("click", event => {
      event.preventDefault();
      if (desktop.matches) return;

      mobileOpen = !mobileOpen;
      if (reducedMotion.matches) {
        sync();
        return;
      }

      const startHeight = details.getBoundingClientRect().height;
      const startOpacity = details.open ? getComputedStyle(content).opacity : "0";
      animation?.cancel();
      contentAnimation?.cancel();
      details.open = true;
      details.dataset.expanded = String(mobileOpen);
      details.dataset.animating = "true";
      const endHeight = mobileOpen
        ? details.getBoundingClientRect().height
        : summary.getBoundingClientRect().height;

      animation = details.animate(
        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
        { duration: 420, easing: "cubic-bezier(0.2, 0, 0, 1)" },
      );
      contentAnimation = content.animate(
        [{ opacity: startOpacity }, { opacity: mobileOpen ? 1 : 0 }],
        { duration: 420, easing: "ease-in-out", fill: "both" },
      );
      animation.onfinish = sync;
    });

    details.addEventListener("toggle", () => {
      if (animation) return;
      if (desktop.matches) {
        if (!details.open) details.open = true;
      } else {
        mobileOpen = details.open;
      }
      details.dataset.expanded = String(details.open);
    });
    desktop.addEventListener("change", sync);
    reducedMotion.addEventListener("change", sync);
    sync();
  });
</script>

<style>
  .Project {
    display: grid;
    gap: 24px;
    padding-block: 32px;
    border-top: 1px solid var(--ui--medium-contrast);
    color: var(--on-background__high-emphasis);
  }
  .Project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    margin: 0 0 12px;
    font: var(--typestyle__body--small);
    color: var(--on-background__medium-emphasis);
  }
  .Project-meta span {
    font-weight: var(--font-weight--bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h3 {
    margin: 0 0 24px;
    max-width: 18ch;
    font: var(--typestyle__h3);
    text-wrap: balance;
    color: var(--on-background__highest-emphasis);
  }
  .Project-facts {
    display: grid;
    gap: 16px;
    margin: 0;
  }
  dt {
    margin-bottom: 4px;
    font: var(--typestyle__h5);
  }
  dd {
    margin: 0;
    max-width: 48ch;
    font: var(--typestyle__body--small);
    color: var(--on-background__medium-emphasis);
  }
  .Project-outcome {
    padding-left: 16px;
    border-left: 3px solid var(--accent);
  }
  .Project-outcome dd {
    font: var(--typestyle__body--bold);
    color: var(--on-background__highest-emphasis);
  }
  .Project-image {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--project-color-tint, var(--project-default-tint));
  }
  .Project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .project-lab1886 { --project-color-tint: var(--lab1886-project-color); }
  .project-lab1886 .Project-image {
    background: linear-gradient(
      to bottom,
      transparent clamp(16px, 2.5vw, 32px),
      var(--project-color-tint) 0
    );
  }
  .project-bosch { --project-color-tint: var(--bosch-project-color); }
  .project-copra { --project-color-tint: var(--copra-project-color); }
  .project-figma { --project-color-tint: var(--design-tokens-project-color); }
  .Project-story {
    border-top: 1px solid var(--ui--fair-contrast);
  }
  .Project-details-heading { display: none; }
  .Project-details[data-animating] { overflow: clip; }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    cursor: pointer;
    list-style: none;
    font: var(--typestyle__h4);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--on-background__highest-emphasis); }
  summary:focus-visible {
    outline: 2px solid var(--on-background__highest-emphasis);
    outline-offset: 4px;
  }
  .Project-toggle {
    position: relative;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }
  .Project-toggle::before,
  .Project-toggle::after {
    content: "";
    position: absolute;
    background: currentColor;
  }
  .Project-toggle::before { width: 16px; height: 2px; top: 7px; }
  .Project-toggle::after {
    width: 2px;
    height: 16px;
    left: 7px;
    transition: transform 420ms cubic-bezier(0.2, 0, 0, 1);
  }
  details[open]:not([data-expanded="false"]) .Project-toggle::after {
    transform: rotate(90deg);
  }
  .Project-process {
    display: grid;
    gap: 24px;
    padding-block: 16px 24px;
    font: var(--typestyle__body--small);
    color: var(--on-background__medium-emphasis);
  }
  .Project-process :global(h5) {
    margin: 0 0 8px;
    font: var(--typestyle__h5);
    color: var(--on-background__high-emphasis);
  }
  .Project-process :global(p) {
    margin: 0 0 20px;
    max-width: 65ch;
  }
  .Project-process :global(p:last-child) { margin-bottom: 0; }
  .Project-process :global(a) { color: inherit; text-decoration: underline; }
  .Project-process ul { margin: 0; padding-left: 20px; }
  .Project-process li + li { margin-top: 6px; }
  .Project-link { padding-top: 8px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .Project-toggle::after { transition: none; }
  }
  @media (--min-tablet) {
    .Project { gap: 32px; padding-block: 48px; }
    .Project-facts { grid-template-columns: 1fr 1fr; gap: 24px; }
    .Project-outcome { grid-column: 1 / -1; }
    .Project-image { aspect-ratio: 16 / 9; }
    .Project-process { grid-template-columns: 2fr 1fr; gap: 48px; }
  }
  @media (--min-desktop) {
    .Project {
      grid-template-columns: 5fr 6fr;
      column-gap: clamp(40px, 5vw, 80px);
      align-items: center;
      padding-block: 56px;
    }
    h3 { font: var(--typestyle__h2); margin-bottom: 28px; }
    .Project-facts { grid-template-columns: 1fr; gap: 20px; }
    .Project-image { aspect-ratio: 4 / 3; }
    .Project-story { grid-column: 1 / -1; }
    .Project-details-heading {
      display: block;
      margin: 20px 0 0;
      font: var(--font-sans-style-normal) var(--font-sans-weight-bold)
        var(--ts-size-lg) / var(--ts-line-height-lg) var(--font-sans);
    }
    summary { display: none; }
    .Project-link { padding-top: 4px; }
  }
</style>
