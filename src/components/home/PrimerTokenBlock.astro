---
const cards = [
  { x: 65, y: 55, angle: -20, name: "text.title.medium", detail: "semibold – 20/32", size: 60, weight: 600, offset: 78 },
  { x: 168, y: 27, angle: -10, name: "text.subtitle", detail: "regular – 20/32", size: 72, weight: 400, offset: 72 },
  { x: 272, y: 22, angle: 0, name: "text.title.large", detail: "semibold – 32/48", size: 120, weight: 600, offset: 52 },
  { x: 378, y: 32, angle: 10, name: "text.title.medium", detail: "semibold – 20/32", size: 72, weight: 600, offset: 68 },
  { x: 477, y: 56, angle: 20, name: "text.display", detail: "semibold – 40/56", size: 150, weight: 600, offset: 48 },
];
const colors = [
  { x: 12, y: 662, width: 299, name: "bgColor.default", color: "#ffffff" },
  { x: 334, y: 662, width: 293, name: "bgColor.muted", color: "#f6f8fa" },
  { x: 651, y: 662, width: 406, name: "bgColor.accent.emphasis", color: "#0969da" },
  { x: 1081, y: 662, width: 423, name: "bgColor.success.emphasis", color: "#1a7f37" },
  { x: 12, y: 776, width: 407, name: "bgColor.accent.emphasis", color: "#cf222e" },
  { x: 442, y: 776, width: 373, name: "bgColor.accent.muted", color: "#ddf4ff" },
  { x: 838, y: 776, width: 389, name: "bgColor.success.muted", color: "#dafbe1" },
  { x: 1249, y: 776, width: 374, name: "bgColor.danger.muted", color: "#ffebe9" },
  { x: 12, y: 890, width: 293, name: "fgColor.default", color: "#24292f", foreground: true },
  { x: 328, y: 890, width: 287, name: "fgColor.muted", color: "#57606a", foreground: true },
  { x: 639, y: 890, width: 291, name: "fgColor.accent", color: "#0969da", foreground: true },
  { x: 954, y: 890, width: 307, name: "fgColor.success", color: "#1a7f37", foreground: true },
  { x: 1284, y: 890, width: 295, name: "fgColor.danger", color: "#cf222e", foreground: true },
];
const radii = [
  { x: 13, y: 1010, name: "borderRadius.sm", detail: "3px", radius: 3, ring: 12 },
  { x: 600, y: 1010, name: "borderRadius.large", detail: "12px", radius: 24, ring: 48 },
  { x: 13, y: 1180, name: "borderRadius.mm", detail: "6px – default", radius: 12, ring: 24 },
  { x: 600, y: 1180, name: "borderRadius.full", detail: "9999px", radius: 9999, ring: 92 },
];
const radiusScale = 1.5;
const ringStroke = 4;
const dotPitch = 7;
const ringPath = (ring: number) => {
  const r = 50 - (ringStroke / 2) * (100 / ring);
  const centerline = ring - ringStroke;
  return { r, strokeWidth: ringStroke * (100 / ring), dots: Math.max(4, Math.round((Math.PI * centerline) / dotPitch)) };
};
const spacing = [
  { x: 43.5, width: 3, label: "2px" }, { x: 110, width: 6, label: "4px" },
  { x: 176.5, width: 9, label: "6px" }, { x: 243.5, width: 12, label: "8px" },
  { x: 313, width: 18, label: "12px" }, { x: 386, width: 24, label: "16px" },
  { x: 461, width: 30, label: "20px" }, { x: 537, width: 36, label: "24px" },
  { x: 613, width: 42, label: "28px" }, { x: 691, width: 48, label: "32px" },
  { x: 775, width: 54, label: "36px" }, { x: 865, width: 60, label: "40px" },
  { x: 961, width: 72, label: "48px" }, { x: 1069, width: 96, label: "64px" },
  { x: 1201, width: 120, label: "80px" },
];
---

<div class="Primer-token-block" data-project-artwork role="img" aria-label="Primer typography cards, color tokens, border radii and spacing tokens">
  <div class="Token-artwork" aria-hidden="true">
    {cards.map(card => (
      <div class="Token-card" style={`--x:${card.x};--y:${card.y};--angle:${card.angle}deg;--size:${card.size};--weight:${card.weight};--offset:${card.offset}`}>
        <span class="Token-font">fontStack/sansSerif</span>
        <span class="Token-sample">Aa</span>
        <div class="Token-type"><strong>{card.name}</strong><span>{card.detail}</span></div>
      </div>
    ))}
    {colors.map(token => (
      <div class="Token-pill" style={`--x:${token.x};--y:${token.y};--width:${token.width};--color:${token.color}`}>
        {token.foreground ? <span class="Token-foreground">Aa</span> : <span class="Token-swatch" />}
        <span>{token.name}</span>
      </div>
    ))}
    {radii.map(token => (
      <div class="Token-radius" style={`--x:${token.x};--y:${token.y};--radius:${token.radius};--ring:${token.ring};--radius-scale:${radiusScale}`}>
        <span class="Token-radius-shape"><svg class="Token-radius-ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r={ringPath(token.ring).r} stroke-width={ringPath(token.ring).strokeWidth} pathLength={ringPath(token.ring).dots} /></svg></span>
        <span class="Token-radius-label"><strong>{token.name}</strong><span>{token.detail}</span></span>
      </div>
    ))}
    {spacing.map(token => (
      <div class="Token-spacing" style={`--x:${token.x};--width:${token.width}`}>
        <span class="Token-spacing-bar" /><span class="Token-spacing-label">{token.label}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .Primer-token-block {
    position: absolute;
    top: 40px;
    left: 40px;
    width: calc(100% * 2724 / 2600 * 0.567);
    aspect-ratio: 1623 / 1579;
    container-type: inline-size;
    pointer-events: none;
  }
  .Token-artwork {
    --u: calc(100cqw / 1623);
    position: absolute;
    inset: 0;
    color: #24292f;
    font: 400 calc(24 * var(--u)) / 1.25 Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .Token-artwork * { box-sizing: border-box; }
  .Token-card, .Token-pill, .Token-radius, .Token-spacing {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
  }
  .Token-card {
    width: calc(400 * var(--u));
    height: calc(456 * var(--u));
    padding: calc(40 * var(--u));
    border: calc(2 * var(--u)) solid #dfe4e9;
    border-radius: calc(40 * var(--u));
    background: #fff;
    box-shadow: 0 calc(2 * var(--u)) calc(4 * var(--u)) #24292f1a;
    rotate: var(--angle);
  }
  .Token-font { white-space: nowrap; font-size: calc(32 * var(--u)); color: #57606a; }
  .Token-sample {
    display: block;
    margin-top: calc(var(--offset) * var(--u));
    font-size: calc(var(--size) * var(--u));
    font-weight: var(--weight);
    line-height: calc(168 * var(--u));
  }
  .Token-type {
    position: absolute;
    inset: auto calc(20 * var(--u)) calc(20 * var(--u));
    height: calc(128 * var(--u));
    padding: calc(20 * var(--u));
    border-radius: calc(24 * var(--u));
    background: #f6f8fa;
    color: #57606a;
    font-size: calc(32 * var(--u));
    line-height: 1.5;
    white-space: nowrap;
  }
  .Token-type strong { display: block; font-size: calc(36 * var(--u)); font-weight: 600; }
  .Token-pill {
    display: flex;
    align-items: center;
    gap: calc(16 * var(--u));
    width: calc(var(--width) * var(--u));
    height: calc(90 * var(--u));
    padding: 0 calc(26 * var(--u));
    border: calc(2 * var(--u)) solid #d0d7de;
    border-radius: calc(50 * var(--u));
    background: #fff;
    white-space: nowrap;
  }
  .Token-swatch {
    width: calc(40 * var(--u));
    height: calc(40 * var(--u));
    flex: none;
    border: calc(1.5 * var(--u)) solid #d0d7de;
    border-radius: 50%;
    background: var(--color);
  }
  .Token-foreground { color: var(--color); font-size: calc(32 * var(--u)); font-weight: 600; }
  .Token-radius {
    display: flex;
    align-items: flex-start;
    gap: calc(20 * var(--u));
    transform: scale(var(--radius-scale));
    transform-origin: 0 0;
  }
  .Token-radius-shape {
    position: relative;
    width: calc(150 * var(--u));
    height: calc(93 * var(--u));
    flex: none;
    background: #fff;
    border: calc(4 * var(--u)) solid #dfe4e9;
    border-radius: calc(var(--radius) * var(--u));
  }
  .Token-radius-ring {
    position: absolute;
    right: calc(-4 * var(--u));
    bottom: calc(-4 * var(--u));
    width: calc(var(--ring) * var(--u));
    height: calc(var(--ring) * var(--u));
    overflow: visible;
  }
  .Token-radius-ring circle {
    fill: #fff;
    stroke: #7c3aed;
    stroke-linecap: round;
    stroke-dasharray: 0 1;
  }
  .Token-radius-label { color: #57606a; line-height: 1.5; white-space: nowrap; }
  .Token-radius-label strong, .Token-radius-label span { display: block; }
  .Token-radius-label strong { font-weight: 600; }
  .Token-spacing { top: calc(1425 * var(--u)); width: calc(var(--width) * var(--u)); }
  .Token-spacing-bar {
    display: block;
    height: calc(96 * var(--u));
    border-radius: calc(5 * var(--u));
    background: #7c3aed;
  }
  .Token-spacing-label {
    position: absolute;
    top: calc(132 * var(--u));
    left: 50%;
    translate: -50% 0;
    color: #57606a;
    font-size: calc(18 * var(--u));
    white-space: nowrap;
  }
  .Primer-token-block[data-state="pending"] { opacity: 0; transform: translateY(64px); }
  .Primer-token-block[data-state="ready"] {
    animation: tokenFade 1200ms ease-in-out, tokenSlide 1500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes tokenFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes tokenSlide { from { transform: translateY(64px); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .Primer-token-block[data-state] { animation: none; transform: none; }
  }
</style>
