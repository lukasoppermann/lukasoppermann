---
import type { HTMLAttributes } from 'astro/types'
export interface Props extends HTMLAttributes<'nav'> {}

const {...attr} = Astro.props;

const activePage = Astro.url.pathname.replace(/^\//, '')

import { email, resumePdfLink } from '../config';
const mailto = `mailto:${email.raw}?subject=Hey,%20what's up?&body=Great%20to%20hear%20from%20you,%20how%20can%20I%20help?`
---
<style>
  nav {
    --header-height: 64px;
    display: flex;
    justify-content: flex-end;
    a {
      position: relative;
      color: var(--on-background__high-emphasis);
      font-size: var(--font-size--default);
      font-weight: var(--font-weight--bold);
      text-transform: uppercase;
      letter-spacing: .2px;
      padding: 8px;
      margin-left: 8px;
      & span {
        transition: none;
      }
      &:after {
        content: "";
        display: inline;
        position: absolute;
        width: 4px;
        height: 4px;
        background: currentColor;
        border-radius: 100%;
        left: 50%;
        transform: translate(-50%, 0);
        opacity: 0;
        transition: opacity .3s ease, bottom .3s ease, width .3s ease, background .3s ease;
        bottom: 8px;
      }
      &.is-active, &:hover {
        &:after {
          bottom: 0;
          opacity: 1;
        }
      }
    }
  }
  @media (--max-tablet) {
    nav {
      --menu-row-height: clamp(4.8rem, calc((100dvh - 112px) / 5), 11.2rem);
      position: absolute;
      left: 0;
      top: 0;
      height: var(--mobile-menu-height, 100vh);
      transform: scaleY(0);
      width: 100%;
      box-sizing: border-box;
      padding: 24px 0;
      overflow-x: hidden;
      overflow-y: auto;
      background: var(--background);
      transition: transform .25s ease .32s;
      transform-origin: top;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      flex-direction: column;
      a {
        font-weight: var(--font-serif-weight-regular);
        font-family: var(--font-serif);
        font-style: var(--font-serif-style-italic);
        /* Reserve 4.5em for the longest label, including serif overhang. */
        font-size: clamp(2.4rem, min(calc((100vw - 80px) / 4.5), calc(var(--menu-row-height) / 1.4)), 8rem);
        line-height: 1.2;
        white-space: nowrap;
        text-transform: none;
        letter-spacing: .5px;
        opacity: 0;
        transform: translate(0, -25%);
        transition: opacity .12s ease-in, transform .2s ease-in, color .25s ease;
        transition-delay: .12s;
        &:nth-child(2) {
          transition-delay: .09s;
        }
        &:nth-child(3) {
          transition-delay: .06s;
        }
        &:nth-child(4) {
          transition-delay: .03s;
        }
        &:nth-child(5) {
          transition-delay: 0s;
        }
        height: var(--menu-row-height);
        flex: 0 0 var(--menu-row-height);
        max-width: 100%;
        padding: 0 32px;
        box-sizing: border-box;
        margin: 0;
        display: flex;
        align-items: center;
        &:after {
          bottom: auto;
          top: calc(50% - 2px);
          left: 16px;
          width: 8px;
          height: 8px;
        }
      }
      &.is-open {
        transform: scaleY(1);
        transition: transform .75s ease 0s;
        & a {
          opacity: 1;
          transform: translate(0, 0);
          transition: opacity .75s ease .4s, transform .75s ease .4s, color .4s ease;
          &:nth-child(2) {
            transition-delay: .6s;
          }
          &:nth-child(3) {
            transition-delay: .8s;
          }
          &:nth-child(4) {
            transition-delay: 1s;
          }
          &:nth-child(5) {
            transition-delay: 1.2s;
          }
        }
      }
    }
  }
</style>

<nav class:list={[attr.class]}>
  <a href="/" class:list={[(activePage === "" && 'is-active')]}><span>Home</span></a>
  <a href="/about" class:list={[(activePage === "about" && 'is-active')]}><span>About</span></a>
  <a
    href={resumePdfLink}
    target='_blank'
    rel='noreferrer'
  ><span>Resume</span></a>
  <a href='/articles' class:list={[(activePage === "/articles" && 'is-active')]}><span>Writing</span></a>
  <a
    href={mailto}
    target='_blank'
    rel='noreferrer'
  ><span>Contact</span></a>
</nav>