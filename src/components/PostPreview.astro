---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import DateTime from './DateTime.astro';
import Headline from './Headline.astro';
import Icon from './Icon.astro';
import Paragraph from './Paragraph.astro';

export interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  article: CollectionEntry<'articles'>['data']
  href?: string
}

const { article: {title, url, published, excerpt}, href: providedHref, ...attr } = Astro.props
const href = providedHref || url
const isExternal = href.startsWith('http')
---
<style>
  a {
    color: var(--on-background__high-emphasis);
    display: block;
    &:is(:hover, :focus-visible) {
      .preview-title {
        background-size: 100% 2px;
      }
    }
    &:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 6px;
    }
    .preview-title {
      background: linear-gradient(currentColor, currentColor) no-repeat left bottom;
      background-size: 0% 2px;
      transition: background-size 300ms var(--easeOutQuint);
    }
    & {
      :global(.date-time) {
        margin-bottom: 0;
        color: var(--on-background__low-emphasis);
        font-size: var(--font-size--caption);
        font-weight: var(--font-weight--bold);
      }
      :global(.svg-icon) {
        display: inline-block;
        margin-left: 8px;
        vertical-align: middle;
        path {
          fill: var(--on-background__high-emphasis);
        }
      }
      .headline {
        margin-bottom: 0 !important;
      }
      :global(p) {
        margin-top: 4px;
      }
    }
  }
</style>

<a class:list={[attr.class]} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noreferrer' : undefined} href={href}>
  <DateTime class="date-time" from={published} />
  <Headline level="3" class="headline"><span class="preview-title">{title}</span><Icon class="svg-icon" type="arrowRight" /></Headline>
  <Paragraph>{excerpt}</Paragraph>
</a>