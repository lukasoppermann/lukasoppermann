---
import { getCollection } from 'astro:content';
import DateTime from '../../components/DateTime.astro';
import Layout from '../../layouts/Layout.astro';
import PostPreview from '../../components/PostPreview.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return articles
    .filter((article) => article.body?.trim())
    .map((article) => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const moreArticles = (await getCollection('articles'))
  .filter((entry) => entry.body?.trim() && entry.slug !== article.slug && entry.data.url !== article.data.url)
  .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime())
  .slice(0, 3);
---

<style>
  .article {
    grid-column: columns;
    min-width: 0;
    width: 100%;
    padding-top: 80px;
    padding-bottom: 120px;
    @media (--min-desktop) {
      max-width: 80rem;
      margin-inline: auto;
      padding-top: 120px;
    }
  }
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
    color: var(--on-background__low-emphasis);
    font-size: var(--font-size--caption);
    font-weight: var(--font-weight--bold);
    & a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--ui--fair-contrast);
      text-underline-offset: 0.2em;
      &:hover {
        color: var(--on-background__high-emphasis);
        text-decoration-color: currentColor;
      }
    }
  }
  h1 {
    margin: 0 0 40px;
    color: var(--on-background__high-emphasis);
    font: var(--typestyle__h2);
    overflow-wrap: anywhere;
  }
  .article-content {
    color: var(--on-background__high-emphasis);
    font: var(--typestyle__body);
    overflow-wrap: anywhere;
    & :global(p),
    & :global(ul),
    & :global(ol),
    & :global(blockquote),
    & :global(pre) {
      margin: 0 0 24px;
    }
    & :global(h2),
    & :global(h3),
    & :global(h4),
    & :global(h5),
    & :global(h6) {
      margin: 48px 0 16px;
      color: var(--on-background__high-emphasis);
    }
    & :global(h2) {
      font: var(--font-sans-style-normal) var(--font-sans-weight-bold) var(--ts-size-xxl) / var(--ts-line-height-xxl) var(--font-sans);
    }
    & :global(h3) {
      font: var(--typestyle__h3);
    }
    & :global(h4) {
      font: var(--typestyle__h4);
    }
    & :global(h5) {
      font: var(--typestyle__h5);
    }
    & :global(h6) {
      font: var(--typestyle__h6);
    }
    & :global(li + li) {
      margin-top: 8px;
    }
    & :global(blockquote) {
      margin-inline: 0;
      padding-left: 24px;
      border-left: 3px solid var(--ui--fair-contrast);
    }
    & :global(blockquote > :last-child) {
      margin-bottom: 0;
    }
    & :global(code) {
      padding: 2px 6px;
      border-radius: 4px;
      background: var(--ui--low-contrast);
      font-family: var(--font-mono);
      font-size: 0.85em;
    }
    & :global(pre) {
      max-width: 100%;
      overflow-x: auto;
      padding: 24px;
      border: 1px solid #eee8d5;
      border-radius: 8px;
      @media (prefers-color-scheme: dark) {
        border-color: transparent;
        color: var(--shiki-dark) !important;
        background-color: var(--shiki-dark-bg) !important;
      }
      font-size: var(--ts-size-sm);
      line-height: 1.6;
      overflow-wrap: normal;
    }
    & :global(pre code) {
      padding: 0;
      background: none;
      font-size: inherit;
    }
    @media (prefers-color-scheme: dark) {
      & :global(pre span) {
        color: var(--shiki-dark) !important;
        font-style: var(--shiki-dark-font-style) !important;
      }
    }
    & :global(hr) {
      height: 0;
      margin: 48px 0;
      border: 0;
      border-top: 1px solid var(--ui--fair-contrast);
    }
    & :global(img) {
      max-width: 100%;
      height: auto;
    }
    & :global(a) {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }
  }
  .original-link {
    margin-top: 48px;
    color: var(--on-background__medium-emphasis);
  }
  .more-articles {
    margin-top: 80px;
    padding-top: 48px;
    border-top: 1px solid var(--ui--fair-contrast);
    & h2 {
      margin: 0 0 32px;
      color: var(--on-background__high-emphasis);
      font: var(--typestyle__h4);
    }
    & :global(.post-preview) {
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--ui--fair-contrast);
    }
  }
  .all-articles {
    display: inline-block;
    color: var(--on-background__high-emphasis);
    font-weight: var(--font-weight--bold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .original-link a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>

<Layout
  title={`${article.data.title} — Lukas Oppermann`}
  description={article.data.excerpt}
  canonicalUrl={article.data.url}
  ogType="article"
>
  <article class="article">
    <div class="eyebrow">
      <a href="/articles">Articles</a>
      <span aria-hidden="true">·</span>
      <DateTime inline from={article.data.published} />
    </div>
    <h1>{article.data.title}</h1>
    <div class="article-content">
      <Content />
    </div>
    <p class="original-link">
      Originally published on <a href={article.data.url} target="_blank" rel="noreferrer">Medium</a>.
    </p>
    {moreArticles.length > 0 && (
      <nav class="more-articles" aria-labelledby="more-articles-title">
        <h2 id="more-articles-title">More articles</h2>
        {moreArticles.map((entry) => (
          <PostPreview article={entry.data} href={`/articles/${entry.slug}/`} class="post-preview" />
        ))}
        <a class="all-articles" href="/articles">All articles</a>
      </nav>
    )}
  </article>
</Layout>
